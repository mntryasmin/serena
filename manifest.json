{
  "manifest_version": 3,
  "name": "Serena",
  "version": "0.1.2",
  "description": "Reduz ou silencia automaticamente o volume durante anúncios em reprodutores de mídia.",
  "icons": {
    "32": "icons/icon32-green.png",
    "48": "icons/icon48-green.png",
    "128": "icons/icon128-green.png"
  },
  "permissions": ["storage", "activeTab"],
  "browser_specific_settings": {
    "gecko": {
      "id": "serena@mntr.yasmin",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Serena — configurações",
    "default_icon": {
      "32": "icons/icon32-green.png",
      "48": "icons/icon48-green.png",
      "128": "icons/icon128-green.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["content/adapters/youtube.js", "content/main.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
